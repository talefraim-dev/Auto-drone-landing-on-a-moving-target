+            self._landing_anchor_full_size_px = cxcywh[2:4].astype(np.float32)
+            self._landing_anchor_virtual_bbox_xyxy = control.copy()
+            self._landing_anchor_mode = "DISABLED_BBOX_CENTER"
+            self._landing_anchor_edge_flags = "NONE"
